{
  "expo": {
    "name": "Macelleria Chiappetta",
    "slug": "macelleria-mobile",
    "version": "1.0.0",
    "scheme": "macelleriachiappetta",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0B0D"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "it.macelleriachiappetta.mobile"
    },
    "android": {
      "package": "it.macelleriachiappetta.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B0B0D"
      }
    },
    "web": { "bundler": "metro" }
  }
}
